# GitHub Actions 发布的镜像，前后端使用同一个完整提交 SHA。
IMAGE_REPOSITORY=ghcr.io/git-creat7/teamdocs
IMAGE_TAG=latest

# 必填密钥，启动 Compose 前分别生成不同的随机值。
DB_NAME=teamdocs
DB_PASSWORD=
REDIS_PASSWORD=

# JWT 使用 HS256，密钥长度至少为 32 字节。
JWT_SECRET=
MINIO_ACCESS_KEY=teamdocsadmin
MINIO_SECRET_KEY=

# 浏览器访问地址；远程访问时需要配置 HTTPS 域名和反向代理。
# 文件公开端点必须指向 S3 API，不能指向 MinIO 控制台，不加尾斜杠。
MINIO_PUBLIC_ENDPOINT=http://localhost:29000
MINIO_CORS_ALLOWED_ORIGIN=http://localhost:15173
MINIO_REGION=us-east-1
MINIO_BUCKET_PUBLIC=teamdocs-public
MINIO_BUCKET_PRIVATE=teamdocs-private

# 宿主机端口：后端与 MinIO 仅绑定本机，Web 可供外部访问。
WEB_PORT=15173
BACKEND_PORT=8080
MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001

# 仅供本机原生运行后端使用，需另外准备可访问的依赖服务。
# Compose 会将这些地址覆盖为容器网络中的服务地址。
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
REDIS_HOST=localhost
REDIS_PORT=6379
MINIO_ENDPOINT=http://localhost:29000

# Agent AI 模型配置（P0 阶段：默认关闭，需配置 OpenAI 协议兼容端点、密钥与模型名）
AGENT_ENABLED=false
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL_NAME=
AGENT_TIMEOUT_SECONDS=60

