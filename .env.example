# =========================
# 1. 基础配置
# =========================
IMAGE_REPOSITORY=ghcr.io/git-creat7/teamdocs
IMAGE_TAG=REPLACE_WITH_COMMIT_SHA
WEB_PORT=15173
BACKEND_PORT=8080

# =========================
# 2. 数据库和安全密钥
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=teamdocs
DB_USERNAME=root
DB_PASSWORD=请填写数据库密码
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=请填写Redis密码
JWT_SECRET=请填写至少32字节的随机密钥

# =========================
# 3. MinIO 文件存储
# =========================
MINIO_ACCESS_KEY=teamdocsadmin
MINIO_SECRET_KEY=请填写MinIO密码
MINIO_CORS_ALLOWED_ORIGIN=http://localhost:15173
MINIO_PUBLIC_ENDPOINT=http://localhost:29000
MINIO_ENDPOINT=http://localhost:29000
MINIO_BUCKET_PUBLIC=teamdocs-public
MINIO_BUCKET_PRIVATE=teamdocs-private

# =========================
# 4. AI 默认聊天模型
# =========================
# 填入有效 Key 后自动启用对应功能，问题或文档片段会发送至配置的服务。
# 可选：管理员可信 HTTP 代理，例如 http://127.0.0.1:7890（IDEA 运行）。
AGENT_PROXY_URL=
AGENT_BASE_URL=填写OPENAI协议URL
AGENT_API_KEY=填写密钥
AGENT_MODEL_NAME=填写模型名称
# 可用输入容量：0 自动（step-5-preview 为 926000，未知模型保守回退 16000）。
# 其他模型或中转限制不同时可填正数，须自行扣除生成空间和估算余量。
AGENT_MAX_INPUT_TOKENS=0
# 32字节随机密钥的 Base64，留空禁用私人配置保存
MODEL_CONFIG_ENCRYPTION_KEY=

# =========================
# 5. Embedding 向量模型
# =========================
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1024

# =========================
# 6. Reranker 重排序模型
# =========================
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=Qwen/Qwen3-Reranker-8B

# =========================
# 7. MCP 联网工具
# =========================
MCP_STEP_URL=https://api.stepfun.com/step_plan/v1/mcp/web_search/mcp
MCP_STEP_API_KEY=

# =========================
# 8. Milvus 语义检索
# =========================
MILVUS_URL=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=teamdocs_qwen3_8b_d1024_v1
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091
MILVUS_MEMORY_LIMIT=4g
MILVUS_STORAGE_USER=teamdocs-vector
MILVUS_STORAGE_PASSWORD=

# =========================
# 9. 图片理解（生成式视觉模型，不替换 Embedding）
# =========================
# 填入有效 Key 后，解析任务会把原图/扫描页/内嵌图发送到此接口。
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_API_KEY=
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
VISION_TIMEOUT_SECONDS=20
VISION_MAX_IMAGES=8
VISION_MAX_IMAGE_BYTES=2097152
VISION_MAX_PIXELS=16000000
VISION_MAX_DIMENSION=1600
VISION_MAX_OUTPUT_TOKENS=4096

# Elasticsearch（本地后端地址；宿主机端口仅绑定 127.0.0.1）
ES_ENABLED=true
ES_URL=http://localhost:9200
ES_PORT=9200
ES_INDEX=teamdocs-chunks
