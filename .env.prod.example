# Application images
IMAGE_TAG=latest

# Stateful services are pinned and upgraded separately from application deploys
MYSQL_IMAGE=mysql@sha256:31b8746d7ed35df65af0cf781a05ed871d2f56ea9daad1c03ec311688d61f94c
REDIS_IMAGE=redis@sha256:983bae20b7619ef65adac7087098dfd6893ad46d03428caae573debb8be30cc7
MINIO_IMAGE=minio/minio@sha256:420663b8685c5396f06405ad516d611db4465939a141cc7d40266342d0f2632d
MINIO_MC_IMAGE=minio/mc@sha256:3e9666a093d0a8fcbbac606346c415ae9277a0ca96989a6bdddd3d03e90a21b4

# Host bindings
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=15173
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=28080
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=29000
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_PORT=29001

# Existing persistent Docker volumes
MYSQL_VOLUME_NAME=replace-with-existing-mysql-volume
REDIS_VOLUME_NAME=replace-with-existing-redis-volume
MINIO_VOLUME_NAME=replace-with-existing-minio-volume

# MySQL
DB_NAME=teamdocs
DB_PASSWORD=change-this-mysql-password

# Redis
REDIS_PASSWORD=change-this-redis-password

# JWT (at least 32 bytes for HS256)
JWT_SECRET=change-this-jwt-secret-at-least-32-bytes

# MinIO
MINIO_PUBLIC_ENDPOINT=https://files.example.com
MINIO_CORS_ALLOWED_ORIGIN=https://teamdocs.example.com
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=teamdocsadmin
MINIO_SECRET_KEY=change-this-minio-password
MINIO_BUCKET_PUBLIC=teamdocs-public
MINIO_BUCKET_PRIVATE=teamdocs-private
