# Host ports exposed by Docker Compose
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=18080
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# MySQL
DB_NAME=teamdocs
DB_PASSWORD=change-this-mysql-password

# Redis
REDIS_PASSWORD=change-this-redis-password

# JWT: use at least 32 bytes for HS256
JWT_SECRET=change-this-jwt-secret-at-least-32-bytes

# MinIO
MINIO_PUBLIC_ENDPOINT=http://localhost:19000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=teamdocsadmin
MINIO_SECRET_KEY=change-this-minio-password
MINIO_BUCKET_PUBLIC=teamdocs-public
MINIO_BUCKET_PRIVATE=teamdocs-private
